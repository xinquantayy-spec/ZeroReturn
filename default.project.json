{
  "name": "EscapeFromBloxov",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "EFB": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "EFBServer": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "EFBClient": { "$path": "src/client" }
      }
    }
  }
}
