{
  "name": "ZeroReturn",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "ZR": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "ZRServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "ZRClient": {
          "$path": "src/client"
        }
      }
    },
    "MaterialService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/materials"
    }
  }
}