--!nonstrict
-- M13 map: MERIDIAN MALL, rebuilt on Interchange's layout at real scale (docs/maps/MERIDIAN_INTERCHANGE_BUILD.md,
-- docs/maps/MERIDIAN_MALL.md). The layout is the reference's (Layout.luau, generated by tools/interchange_layout.py), the
-- buildings and names are ours. Rojo makes this folder one ModuleScript with the parts below as children; each part is
-- `return function(B)` and runs in this order, each under pcall (a failing part is logged and the rest still build; a part
-- that does not exist yet is skipped):
--   Ground   terrain, roads, ramps, car park markings, rails, fences, power lines, boundary, hazard bands, rocks   (foundation)
--   Outside  THE SUBSTATION and its power switch, the camps, the checkpoint, booths, huts, sheds, the sign pylons  (foundation)
--   Mall     the shell: outer walls, floors, roof, corridors, vertical links, docks, the empty store units          (mall agent)
--   Stores   every store's interior, containers and loose loot                                                      (stores agents)
--   Play     extracts, spawns by side, AI routes, posts, scav zones, the boss, outdoor loot                         (gameplay agent)
--   Dress    outdoor and car park clutter: cars, trolleys, barriers, cones, bins, nature                            (gameplay agent)
-- Local coordinates everywhere: studs, x east, z south (north = -z), S = 3.125 studs per metre; y 0 = the L0 floor of the
-- mall and the flat ground around it (L1 at 17.81, L2 at 47.5). H.V(x, y, z) adds the map origin O.
-- The context B every part gets:
--   kit, W (kit.World), map (the "Meridian" model), H (MapKit for this origin), Kit (the Blender prop kit), L (Layout), O (map
--   origin, Vector3), S (studs per metre), rng, count (part counters for the summary line), points (named world points that
--   Outside sets, see Outside.luau), powerHooks (functions called with true/false whenever the power lever changes),
--   hasMall (a Mall part exists, so Ground does not build the placeholder outline),
--   ground(x, z) local ground height (a lookup in the terrain grid; 0 until Ground has run),
--   Ground adds: inside(x, z) (inside the playable polygon), insideLimit(x, z) (inside the outer limit, hazard bands included),
--   band(x, z) (0 playable, 1 minefield, 2 sniper), classAt(x, z), wet(x, z), slope(x, z), inMall(x, z) and T (TerrainKit result).
local ORIGIN = Vector3.new(0, 0, 9000)
local S = 3.125

return function(kit, root)
	local W = kit.World
	local t0 = os.clock()
	local map = kit.model("Meridian", root)
	local L = require(script.Layout)
	local H = require(script.Parent.MapKit)(kit, ORIGIN)
	local Kit = require(script.Parent.Kit)
	local function yes(_x, _z)
		return true
	end
	local function zero(_x, _z)
		return 0
	end
	local B = {
		kit = kit, W = W, map = map, H = H, Kit = Kit, L = L, O = ORIGIN, S = S, rng = Random.new(9013),
		count = {}, points = {}, powerHooks = {},
		hasMall = script:FindFirstChild("Mall") ~= nil,
		ground = zero, inside = yes, insideLimit = yes, band = zero, classAt = zero, slope = zero,
		wet = function(_x, _z)
			return false
		end,
		inMall = function(_x, _z)
			return false
		end,
	}
	for _, name in { "Ground", "Outside", "Mall", "Stores", "Play", "Dress" } do
		local mod = script:FindFirstChild(name)
		if mod then
			local ok, err = pcall(function()
				require(mod)(B)
			end)
			if not ok then
				warn("[ZR] Meridian: " .. name .. " failed: " .. tostring(err))
			end
		end
	end

	-- the area the AI samples for cover points (world coordinates) and the floor heights it keeps: it starts below the roof,
	-- so the L2 floor is the highest it finds
	local bx = L.box
	W.bounds = {
		x0 = ORIGIN.X + bx[1], x1 = ORIGIN.X + bx[3], z0 = ORIGIN.Z + bx[2], z1 = ORIGIN.Z + bx[4],
		yMin = -30, yMax = 60, step = 9, -- 9: the map is about 14 times the area of Border Yard's plain
	}
	-- clients scatter grass, ferns and reeds over this terrain (Detail controller)
	local lb = L.lbox
	table.insert(W.natureRegions, { ORIGIN.X + lb[1] - 24, ORIGIN.Z + lb[2] - 24, ORIGIN.X + lb[3] + 24, ORIGIN.Z + lb[4] + 24, -62, 70 })

	local nParts = 0
	for _, d in map:GetDescendants() do
		if d:IsA("BasePart") then
			nParts += 1
		end
	end
	local c = B.count
	print(string.format(
		"[ZR] Meridian: %d terrain columns, %d road, %d dash, %d bay mark, %d rail, %d fence, %d pylon, %d wire, %d rock, %d boundary, %d hazard, %d kart, %d ramp, %d structures, %d props, %d doors, %d containers, %d parts in all, %.1fs",
		c.terrain or 0, c.road or 0, c.dash or 0, c.mark or 0, c.rail or 0, c.fence or 0, c.pylon or 0, c.wire or 0, c.rock or 0, c.boundary or 0,
		c.hazard or 0, c.kart or 0, c.ramp or 0, c.struct or 0, c.prop or 0, c.door or 0, c.container or 0, nParts, os.clock() - t0
	))
	return map
end
