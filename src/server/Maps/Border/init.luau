--!nonstrict
-- M13 map: BORDER YARD, rebuilt on Customs' current layout at real scale (docs/maps/BORDER_CUSTOMS_BUILD.md,
-- docs/maps/BORDER_YARD.md). The layout is the reference's (Layout.luau, generated by tools/customs_layout.py), the
-- buildings and names are ours. Rojo makes this folder one ModuleScript with the parts below as children; each part is
-- `return function(B)` and runs in this order, each under pcall (a failing part is logged and the rest still build):
--   Ground    terrain, river, roads, rails, bridges, fences, power lines, boundary, forests, rocks   (foundation)
--   Buildings every structure, interiors, containers and loose loot inside                          (buildings agent)
--   Play      extracts, spawns by side, AI routes, posts, scav zones, the boss, outdoor loot          (gameplay agent)
--   Dress     outdoor clutter: wrecks, poles, cover, nature                                           (gameplay agent)
-- Local coordinates everywhere: studs, x east, z south (north = -z), S = 3.125 studs per metre, y 0 = the flat plain
-- (the origin is the centre of the reference's 1070 x 544 m bounds). H.V(x, y, z) adds the map origin O.
-- The context B every part gets:
--   kit, W (kit.World), map (the "Border" model), H (MapKit for this origin), Kit (the Blender prop kit), L (Layout),
--   O (map origin, Vector3), S (studs per metre), rng, count (part counters for the summary line),
--   ground(x, z)  local ground height (a lookup in the terrain grid; 0 until Ground has run),
--   Ground adds: inside(x, z) (inside the playable boundary), riverD(x, z) (studs inside the river channel, negative on
--   land), slope(x, z), T (the TerrainKit result, T.gy raycasts), islandTop (y of the island in the river).
local ORIGIN = Vector3.new(0, 0, -5200)
local S = 3.125

return function(kit, root)
	local W = kit.World
	local t0 = os.clock()
	local map = kit.model("Border", root)
	local L = require(script.Layout)
	local H = require(script.Parent.MapKit)(kit, ORIGIN)
	local Kit = require(script.Parent.Kit)
	local B = {
		kit = kit, W = W, map = map, H = H, Kit = Kit, L = L, O = ORIGIN, S = S, rng = Random.new(5207),
		count = {},
		ground = function(_x, _z)
			return 0
		end,
	}
	for _, name in { "Ground", "Buildings", "Play", "Dress" } do
		local ok, err = pcall(function()
			require(script[name])(B)
		end)
		if not ok then
			warn("[ZR] Border: " .. name .. " failed: " .. tostring(err))
		end
	end

	-- the area the AI samples for cover points (world coordinates) and the floor heights it keeps: the plateau, the
	-- derrick roof, the river bed and the basements are all inside
	local bx = L.box
	W.bounds = {
		x0 = ORIGIN.X + bx[1], x1 = ORIGIN.X + bx[3], z0 = ORIGIN.Z + bx[2], z1 = ORIGIN.Z + bx[4],
		yMin = -60, yMax = 180, step = 4,
	}
	-- clients scatter grass, ferns and reeds over this terrain (Detail controller)
	table.insert(W.natureRegions, { ORIGIN.X + bx[1] - 24, ORIGIN.Z + bx[2] - 24, ORIGIN.X + bx[3] + 24, ORIGIN.Z + bx[4] + 24, -62, 70 })

	local c = B.count
	print(string.format(
		"[ZR] Border: %d terrain columns, %d road, %d rail, %d crossing, %d fence, %d tree, %d bush, %d rock, %d boundary, %d pylon, %d wire, %d bridge parts, %d parts in all, %.1fs",
		c.terrain or 0, c.road or 0, c.rail or 0, c.crossing or 0, c.fence or 0, c.tree or 0, c.bush or 0, c.rock or 0,
		c.boundary or 0, c.pylon or 0, c.wire or 0, c.bridge or 0, #map:GetDescendants(), os.clock() - t0
	))
	return map
end
